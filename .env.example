# VM: salvar como .env fora do Git. Local: salvar como .env.local.
DATABASE_URL=postgresql://tba_user:SENHA_DO_BANCO@portais-postgres:5432/tba2026
APP_ORIGIN=https://votacao-tba.estacaolab.com.br
ADMIN_PASSWORD=
# Gerar um segredo aleatório com pelo menos 32 caracteres.
SESSION_SECRET=
APP_VERSION=local
APP_NETWORK_ALIAS=tba-votacao
BACKUP_DIR=/srv/portais/backups/tba2026
# Somente desenvolvimento local:
# HOST=127.0.0.1
# PORT=3100
# APP_ORIGIN=http://127.0.0.1:3100

# Backup: senha original do banco (não a versão percent-encoded da URI).
BACKUP_DB_PASSWORD=
BACKUP_DB_HOST=portais-postgres
BACKUP_DB_NAME=tba2026
BACKUP_DB_USER=tba_votacao_app
